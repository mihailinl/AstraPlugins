{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraplugins.minice.ai/spec/games/schemas/link-v1-ai-data-profile.schema.json",
  "title": "The Link AI profile (a meta-schema)",
  "description": "link-v1.md §6 'The AI profile'. Validates a JSON Schema FILE whose data reaches the AI or a plugin -- [integration.link].context, .events[].data and .tools[].result -- not game data itself. The restriction of link-v1-data-schema-profile.schema.json with one leaf fewer (no string property except an enum, so a game never puts text in front of the model), property names and enum values as ids, at most 64 values in an enum. A description never reaches the model.",
  "type": "object",
  "required": ["type", "properties", "additionalProperties"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "type": { "const": "object" },
    "additionalProperties": { "const": false },
    "required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/leafProperty" }
    }
  },
  "$defs": {
    "leafProperty": {
      "oneOf": [
        {
          "type": "object",
          "required": ["enum"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "string" },
            "enum": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" } },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "integer" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "number" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "boolean" },
            "description": { "type": "string" }
          }
        }
      ]
    }
  }
}
