{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraplugins.minice.ai/spec/games/schemas/link-v1-message.schema.json",
  "title": "astra.link/1 wire message",
  "description": "link-v1.md §4. One object per WebSocket frame; validates the envelope shape only -- the declared-name and schema-validity rules on event/trigger/call payloads are checked against the GI's own [integration.link] declaration, not by this schema.",
  "oneOf": [
    {
      "type": "object",
      "required": ["t", "integration", "v", "client"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "hello" },
        "token": { "type": "string" },
        "resume": { "type": "string" },
        "integration": { "type": "string", "minLength": 1 },
        "v": { "type": "integer", "minimum": 1 },
        "client": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["t", "granted", "limits", "resume"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "welcome" },
        "granted": { "$ref": "#/$defs/grantedSet" },
        "limits": {
          "type": "object",
          "description": "link-v1.md §4: integers, at most the protocol's own (65536, 50); unknown members are ignored.",
          "properties": {
            "max_message_bytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
            "max_messages_per_second": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        },
        "resume": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["t", "name", "data"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "event" },
        "name": {
          "enum": ["session_started", "session_ended", "player_hurt", "player_fell", "player_died", "player_revived", "goal_reached"],
          "description": "link-v1.md §5 'Event words': the closed v1 list. Any other word is refused with error{unknown_event}."
        },
        "data": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": ["t", "data"],
      "additionalProperties": false,
      "description": "link-v1.md §4, §5 'Events and context'. Facts valid against the declared context schema (the AI profile, §6); never text.",
      "properties": {
        "t": { "const": "context" },
        "data": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": ["t", "name", "data"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "trigger" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "data": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": ["t", "id", "tool", "args"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "call" },
        "id": { "type": "string" },
        "tool": { "type": "string" },
        "args": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": ["t", "id", "ok"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "result" },
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "data": {},
        "error": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "description": "link-v1.md §5 'Refusal codes': not_holding, not_in_world, player_dead, busy, unknown_target, bad_args, or another code of this shape (the daemon's own not_in_game has it too)."
        }
      }
    },
    {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "description": "link-v1.md §5 'Voice key'. No text: the words are the user's own.",
      "properties": {
        "t": { "const": "talk" }
      }
    },
    {
      "type": "object",
      "required": ["t", "on"],
      "additionalProperties": false,
      "description": "link-v1.md §5 'Speaking on her own': true while the game is in a menu, a cutscene or paused.",
      "properties": {
        "t": { "const": "quiet" },
        "on": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "required": ["t", "granted"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "grants" },
        "granted": { "$ref": "#/$defs/grantedSet" }
      }
    },
    {
      "type": "object",
      "required": ["t", "reason"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "end" },
        "reason": { "enum": ["withdrawn", "stopped", "replaced", "game_exited", "catalogue_stale"] }
      }
    },
    {
      "type": "object",
      "required": ["t", "code"],
      "additionalProperties": false,
      "properties": {
        "t": { "const": "error" },
        "code": { "enum": ["not_granted", "rate_limited", "too_large", "bad_schema", "unknown_event", "withdrawn"] }
      }
    }
  ],
  "$defs": {
    "grantedSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "context": { "type": "boolean" },
        "skill": { "type": "boolean" },
        "speaks": { "type": "boolean" },
        "talk": { "type": "boolean" }
      }
    }
  }
}
