{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraplugins.minice.ai/spec/games/schemas/link-v1-data-schema-profile.schema.json",
  "title": "The restricted Link data-schema profile (a meta-schema)",
  "description": "link-v1.md §6. Validates a JSON Schema FILE named by [integration.link].tools[].params / .triggers[].data / .events[].data -- not game data itself. A params/data file must pass THIS schema before it is ever used to validate a live event/trigger/call payload. The linear-time-regex requirement on 'pattern' is not structurally expressible here; gi-probe enforces it at the byte level.",
  "type": "object",
  "required": ["type", "properties", "additionalProperties"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "type": { "const": "object" },
    "additionalProperties": { "const": false },
    "required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": { "$ref": "#/$defs/leafProperty" }
    }
  },
  "$defs": {
    "leafProperty": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "maxLength"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "string" },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 64 },
            "pattern": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["enum"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "string" },
            "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "integer" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "number" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "description": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "boolean" },
            "description": { "type": "string" }
          }
        }
      ]
    }
  }
}
