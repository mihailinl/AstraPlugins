{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraplugins.minice.ai/spec/games/schemas/manifest.schema.json",
  "title": "astra-gi.toml, schema 1 (JSON projection)",
  "description": "A manifest as JSON, isomorphic to the TOML astra-game-launcher reads. Covers both the base sections GAME-INTEGRATION-MANIFEST.md already defines and the [integration.*] additions in manifest.md. additionalProperties:false mirrors exactly the sections astra-game-launcher's src/manifest.rs refuses an unknown key in (TOP_KEYS, TARGET_KEYS, FILES_KEYS, GAME_FILES_KEYS, LAUNCH_KEYS, CONFIG_WRITES_KEYS); [integration] itself stays open, because v0.3.1 reads it with no key check at all.",
  "type": "object",
  "required": ["schema", "integration", "target"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "integration": { "$ref": "#/$defs/integration" },
    "target": { "$ref": "#/$defs/target" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/fileRule" } },
    "game_files": { "type": "array", "items": { "$ref": "#/$defs/gameFileRule" } },
    "launch": { "$ref": "#/$defs/launch" },
    "config_writes": { "type": "array", "items": { "$ref": "#/$defs/configWrite" } }
  },
  "$defs": {
    "engineCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "spec/games/reserved.yaml engine_code_pattern. Reservation (the four built-ins, 'unknown', or a code already owned by another publisher) is an ingest-time fact, not a structural one, so it is not re-expressed as a schema enum."
    },

    "integration": {
      "type": "object",
      "description": "Metadata. v0.3.1 reads this table with no key check (src/manifest.rs:27-38), so additionalProperties stays true — a future [integration.*] table must be readable by today's client without a schema bump.",
      "required": ["id", "name", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "repo": { "type": "string" },
        "sdk": {
          "type": "string",
          "description": "manifest.md §2.5. Metadata only; shown in Settings -> Developer, never on the install sheet."
        },
        "engine": { "$ref": "#/$defs/integrationEngine" },
        "loader": { "$ref": "#/$defs/integrationLoader" },
        "capabilities": { "$ref": "#/$defs/integrationCapabilities" },
        "foundation": { "$ref": "#/$defs/integrationFoundation" },
        "link": { "$ref": "#/$defs/integrationLink" }
      }
    },

    "integrationEngine": {
      "type": "object",
      "description": "manifest.md §2.1. Present only on the foundation that owns this engine code. Its full astra.engine/1 grammar is normative in engine-descriptor-v1.md and validated by engine-descriptor-v1.schema.json; this is a structural placeholder so manifest.schema.json alone can confirm the table's presence and its schema tag.",
      "required": ["schema"],
      "properties": {
        "schema": { "const": "astra.engine/1" }
      }
    },

    "integrationLoader": {
      "type": "object",
      "description": "manifest.md §2.2. proxies and keep_if_present must be disjoint (loader-policy-conflict); that is a cross-field rule gi-probe enforces, not expressible as a plain JSON Schema constraint here.",
      "additionalProperties": false,
      "properties": {
        "proxies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" }
        },
        "keep_if_present": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" }
        }
      }
    },

    "integrationCapabilities": {
      "type": "object",
      "description": "manifest.md §2.3. v1's only companion id is 'presentation'.",
      "additionalProperties": false,
      "properties": {
        "companion": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "integrationFoundation": {
      "type": "object",
      "description": "manifest.md §2.4. A claim only; ingest computes built_on{entry,version,verified} from digests.",
      "required": ["id", "version", "engine"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "engine": { "$ref": "#/$defs/engineCode" }
      }
    },

    "integrationLink": {
      "type": "object",
      "description": "manifest.md §2.6. Structural shape only; the message protocol and the restricted data-schema profile are normative in link-v1.md and its own schemas/ files.",
      "additionalProperties": false,
      "properties": {
        "context": { "type": "boolean" },
        "shares_other_players": { "type": "boolean" },
        "skill": { "type": "string" },
        "tools": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["name", "description", "params"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "description": { "type": "string", "maxLength": 200 },
              "params": { "type": "string" }
            }
          }
        },
        "triggers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["name", "label", "data"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "data": { "type": "string" }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["name", "data"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "data": { "type": "string" }
            }
          }
        }
      }
    },

    "target": {
      "type": "object",
      "required": ["exe", "platforms", "anti_cheat"],
      "additionalProperties": false,
      "properties": {
        "steam_appid": { "type": "integer", "minimum": 1 },
        "exe": { "type": "string", "minLength": 1 },
        "engine": { "$ref": "#/$defs/engineCode" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["windows-x64", "linux-proton"] }
        },
        "anti_cheat": { "type": "string", "minLength": 1 }
      }
    },

    "fileRule": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },

    "gameFileRule": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },

    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": { "type": "array", "items": { "type": "string" } },
        "proton_dll_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["native", "builtin", "native,builtin", "builtin,native", "n", "b", "n,b", "b,n", ""]
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "configWrite": {
      "type": "object",
      "required": ["file", "section", "set"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "set": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
