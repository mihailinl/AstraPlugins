{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraplugins.minice.ai/spec/games/schemas/link-v1-trigger-data-profile.schema.json",
  "title": "The Link trigger-data profile (a meta-schema)",
  "description": "link-v1.md section 6 'The trigger profile'. Validates a JSON Schema FILE named by [integration.link].triggers[].data -- not game data itself. The restriction of link-v1-data-schema-profile.schema.json, with property names as ids: each property of a trigger's data reaches an automation as the variable {game_<key>}, and the command parser reads a variable name only as letters, digits and _, so a name with a hyphen or a capital would be dropped silently. A string with maxLength stays allowed: trigger data never reaches a model (link-v1.md section 5 'Triggers').",
  "type": "object",
  "required": [
    "type",
    "properties",
    "additionalProperties"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "const": "object"
    },
    "additionalProperties": {
      "const": false
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "properties": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/leafProperty"
      }
    }
  },
  "$defs": {
    "leafProperty": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "maxLength"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "pattern": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "enum"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
