{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraplugins.minice.ai/spec/content/schemas/packs-index-v1.schema.json",
  "title": "astra.packs.index/1",
  "description": "spec/content/packs-index-v1.md. GENERATED by tools/gen-content-schemas.py. The envelope is the plugin one (docs/en/spec/registry-index.md §1); signature, freshness, kind-key scoping and the cross-field rules are tools/check-content-goldens.py's semantic rules, not this schema's.",
  "type": "object",
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "signed": {
      "$ref": "#/$defs/signed"
    },
    "signatures": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/signature"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?|(>=|>)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(,(<=|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?)?|(<=|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?)$"
    },
    "unixSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "https": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "httpsOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/https"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "sig"
      ],
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "version",
        "author",
        "listing",
        "thumbnail",
        "members",
        "review",
        "published_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "listing": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "title",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        },
        "thumbnail": {
          "type": "object",
          "required": [
            "sha256",
            "size"
          ],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "version",
              "digest"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "character",
                  "model",
                  "animset",
                  "game-integration"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9./-]*$"
              },
              "version": {
                "$ref": "#/$defs/semver"
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "review": {
          "enum": [
            "unchecked",
            "reviewed"
          ]
        },
        "published_at": {
          "$ref": "#/$defs/unixSeconds"
        }
      }
    },
    "signed": {
      "type": "object",
      "required": [
        "schema",
        "serial",
        "issued_at",
        "expires_at",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "astra.packs.index/1"
        },
        "serial": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at": {
          "$ref": "#/$defs/unixSeconds"
        },
        "expires_at": {
          "$ref": "#/$defs/unixSeconds"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    }
  }
}
