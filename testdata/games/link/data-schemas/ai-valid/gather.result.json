{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "started"
  ],
  "properties": {
    "started": {
      "type": "boolean"
    },
    "resource": {
      "type": "string",
      "enum": [
        "wood",
        "stone",
        "copper_ore",
        "tin_ore"
      ]
    },
    "target_amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "distance_m": {
      "type": "number",
      "minimum": 0
    }
  }
}
